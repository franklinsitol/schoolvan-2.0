{
  "name": "SchoolVan - Gestão de Transporte Escolar",
  "short_name": "SchoolVan",
  "id": "schoolvan-app-pwa",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#0b0f17",
  "theme_color": "#0b0f17",
  "lang": "pt-BR",
  "dir": "ltr",
  "orientation": "portrait",
  "description": "Aplicativo PWA oficial para gestão de transporte escolar, carteira de alunos e rastreamento em tempo real.",
  "iarc_rating_id": "e58c1714-4b5f-4024-82a1-0f7236531d0f",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.schoolvan.app",
      "id": "com.schoolvan.app"
    },
    {
      "platform": "webapp",
      "url": "https://schoolvansandbox.pages.dev/manifest.json"
    }
  ],
  "categories": ["education", "travel", "productivity", "utilities"],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 480
  },
  "note_taking": {
    "new_note_url": "/?note=new"
  },
  "file_handlers": [
    {
      "action": "/?file_handler=true",
      "name": "Dados e Documentos SchoolVan",
      "accept": {
        "text/csv": [".csv"],
        "application/json": [".json"],
        "application/pdf": [".pdf"]
      },
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "widgets": [
    {
      "name": "Status do Transporte SchoolVan",
      "short_name": "Van Status",
      "description": "Widget de acompanhamento das rotas e localização em tempo real",
      "tag": "schoolvan-widget",
      "template": "van-status-template",
      "ms_ac_template": "/widgets/van-status.json",
      "data": "/widgets/data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshot-mobile.png",
          "sizes": "750x1334",
          "type": "image/png",
          "label": "Widget de Status SchoolVan"
        }
      ],
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/?share=true",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+schoolvan",
      "url": "/?protocol=%s"
    }
  ],
  "scope_extensions": [
    {
      "type": "origin",
      "origin": "https://schoolvansandbox.pages.dev"
    },
    {
      "type": "origin",
      "origin": "https://schoolvan.app"
    }
  ],
  "icons": [
    {
      "src": "/favicon.png",
      "sizes": "64x64",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Painel de Gestão e Rotas SchoolVan"
    },
    {
      "src": "/screenshot-mobile.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Rastreamento do Transporte Escolar no Celular"
    }
  ],
  "shortcuts": [
    {
      "name": "Minhas Rotas",
      "short_name": "Rotas",
      "description": "Visualizar mapa de rotas ativas",
      "url": "/?view=routes",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Passageiros",
      "short_name": "Alunos",
      "description": "Lista de alunos e presença",
      "url": "/?view=students",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    }
  ]
}
